# OpenAI-compatible provider config for interns to use when they implement the backend.
# Do not expose OPENAI_API_KEY in client-side frontend code.

PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ticketassist?schema=public
STORAGE_DRIVER=sftp
NETWORK_FILE_STORAGE=/opt/ticketassist/storage
SFTP_HOST=YOUR_DROPLET_IP
SFTP_PORT=22
SFTP_USERNAME=root
SFTP_PASSWORD=
REPOSITORY_UPLOAD_MAX_FILES=2000
REPOSITORY_UPLOAD_MAX_FILE_SIZE_MB=25
DEFAULT_CODEBASE_PATH=D:\ticketassist\backend\codebasetest\CardSeller-main\CardSeller
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-at-least-16-characters
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_EXTRA_HEADERS={}

# Suggested per-agent model placeholders.
AI_MODEL_ANALYZER=gpt-4.1-mini
AI_MODEL_PRIORITY=gpt-4.1-mini
AI_MODEL_CODE_CONTEXT=gpt-4.1-mini
AI_MODEL_FIX_PROPOSAL=gpt-4.1-mini
AI_MODEL_MENTOR_DRAFT=gpt-4.1-mini
