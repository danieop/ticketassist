# OpenAI-compatible provider config for interns to use when they implement the backend.
# Do not expose OPENAI_API_KEY in client-side frontend code.

PORT=4000
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_EXTRA_HEADERS={}

# Suggested per-agent model placeholders.
AI_MODEL_ANALYZER=gpt-4.1-mini
AI_MODEL_PRIORITY=gpt-4.1-mini
AI_MODEL_CODE_CONTEXT=gpt-4.1-mini
AI_MODEL_FIX_PROPOSAL=gpt-4.1-mini
AI_MODEL_MENTOR_DRAFT=gpt-4.1-mini
